extends layout

block content
    button#detectStartButton start detection
    button#detectEndButton(disabled) end detection

    script.
        let isDetectionActive = false
        function $(s) {return document.querySelector(s)}
        function $$(s) {return document.querySelectorAll(s)}
        async function sendMessage(s) {return await fetch('/chatbox/message?message='+s)}

        var SpeechRecognition = SpeechRecognition || webkitSpeechRecognition
        var SpeechRecognitionEvent = SpeechRecognitionEvent || webkitSpeechRecognitionEvent

        let recognition;

        $('#detectStartButton').addEventListener('click', function() {
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.lang = '!{lang}';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;
            recognition.onresult = async function (event) {
                const str = event.results[0][0].transcript
                await sendMessage(str)
            }
            recognition.onspeechend = function () {
                recognition.stop()
                if (isDetectionActive) $('#detectStartButton').dispatchEvent(new Event('click'))
            }
            recognition.onnomatch = () => recognition.onspeechend()
            recognition.onerror = () => recognition.onspeechend()

            recognition.start()
            $('#detectStartButton').disabled = true
            $('#detectEndButton').disabled = false
            isDetectionActive = true
        })

        $('#detectEndButton').addEventListener('click', function () {
            $('#detectStartButton').disabled = false
            $('#detectEndButton').disabled = true
            isDetectionActive = false
            recognition.stop()
        })